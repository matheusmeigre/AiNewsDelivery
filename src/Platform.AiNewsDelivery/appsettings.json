{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{SourceContext}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithEnvironmentName" ]
  },
  "Worker": {
    "CronSchedule": "0 0 */12 * * *",
    "DatabasePath": "news-delivery.db",
    "MaxRetryAttempts": 3,
    "Thresholds": {
      "EloChangePercent": 5.0,
      "PriceChangePercent": 10.0,
      "TokensPerSecChangePercent": 15.0,
      "PriceDropSignificantPercent": 20.0,
      "HuggingFaceMinDownloads": 10000
    }
  },
  "Sources": {
    "OpenRouter": {
      "BaseUrl": "https://openrouter.ai/api/v1",
      "Enabled": true
    },
    "HuggingFace": {
      "BaseUrl": "https://huggingface.co/api",
      "Token": "",
      "Enabled": true
    },
    "ArtificialAnalysis": {
      "BaseUrl": "https://api.artificialanalysis.ai",
      "ApiKey": "",
      "Enabled": false
    },
    "GitHub": {
      "Token": "",
      "Enabled": false,
      "TrackedRepos": [
        "meta-llama/llama-models",
        "QwenLM/Qwen2.5",
        "mistralai/mistral-inference"
      ]
    }
  },
  "RabbitMq": {
    "Host": "",
    "Port": 5672,
    "Username": "guest",
    "Password": "guest"
  }
}
